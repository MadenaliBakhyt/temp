# Environment Variables for TokenFactory dApp

# Chain Configuration
VITE_CHAIN_ID=11155111
VITE_CHAIN_NAME=Sepolia

# Contract Addresses (Update after deployment)
VITE_FACTORY_ADDRESS=0x...
VITE_SWAP_ADDRESS=0x...

# Backend API URL
VITE_BACKEND_URL=http://localhost:3001/api

# The Graph Subgraph URL (Update after subgraph deployment)
VITE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/...

# RPC URL (Optional - wagmi can use public RPCs)
# VITE_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR-API-KEY

# WalletConnect Project ID (Optional - for WalletConnect support)
# Get from: https://cloud.walletconnect.com/
# VITE_WALLETCONNECT_PROJECT_ID=your-project-id

# App Metadata
VITE_APP_NAME=TokenFactory
VITE_APP_DESCRIPTION=Create and swap ERC-20 tokens
